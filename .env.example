# --- PostgreSQL ---
POSTGRES_USER=bpm
POSTGRES_PASSWORD=bpm
POSTGRES_DB=bpm_log

# --- Backend ---
# Pour le dev local hors Docker, pointe vers localhost.
# En Docker Compose, l'host est "db" (surchargé par docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://bpm:bpm@localhost:5432/bpm_log

# Mode debug : expose Swagger sur /docs (TOUJOURS false en prod)
DEBUG=true

# CORS : origines autorisées (frontend), tableau JSON
# Dev :  CORS_ORIGINS=["http://localhost:5173","http://localhost"]
# Prod : CORS_ORIGINS=["https://log.bpmclubsono.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost"]

# --- OIDC / authentik (authentification) ---
# Voir docs/authentik-sso.md. Le backend ne signe plus de token : il vérifie
# ceux d'authentik via la clé publique publiée sur OIDC_JWKS_URL.
OIDC_ISSUER=https://auth.bpmclubsono.com/application/o/bpm-log/
OIDC_CLIENT_ID=
OIDC_JWKS_URL=https://auth.bpmclubsono.com/application/o/bpm-log/jwks/

# Mêmes valeurs côté frontend. Préfixe VITE_ = inliné dans le bundle au build,
# donc lues par docker compose comme build args (pas au runtime).
# Le client_id n'est pas un secret : il transite dans l'URL du navigateur.
VITE_OIDC_ISSUER=https://auth.bpmclubsono.com/application/o/bpm-log/
VITE_OIDC_CLIENT_ID=


# --- Web-Push (VAPID) ---
# Génère : python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); ..."
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@bpmclubsono.com

# --- Stockage photos ---
PHOTOS_DIR=/var/bpm/photos

